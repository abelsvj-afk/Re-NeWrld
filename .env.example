# Environment Configuration Template for Re:NeWrld
# Copy this file to .env and configure local values. NEVER commit .env to version control.

# Application Environment (development, test, staging, production)
APP_ENV=development

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Service Configuration Placeholders
PORT=8080
HOST=0.0.0.0

# Rate limiting (requests per IP per window; tighter for login/register;
# strictest for the password-reset endpoints, which are account-takeover targets)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW_MS=3600000

# Browser frontend origin for CORS (e.g. https://app.renewrld.com).
# Leave unset for API-only mode (no CORS headers).
# CORS_ORIGIN=

# Email delivery for password reset (FR-13, ADR-012).
# 'console' logs the reset link (dev/test default); 'resend' sends via the
# Resend API (free tier: 3,000 emails/month).
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend. Get one free at https://resend.com.
# RESEND_API_KEY=
# Sender identity shown on reset emails (use a verified domain with Resend).
EMAIL_FROM=Re:NeWrld <noreply@example.com>
# Public base URL used to build the reset link emailed to users.
APP_BASE_URL=http://localhost:8080

# Database Connection URL (required, valid PostgreSQL URL)
# Placeholder only - put real local credentials in your own .env (gitignored), never commit them.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/rene_wrld
