# Environment Configuration Template for Re:NeWrld
# Copy this file to .env and configure local values. NEVER commit .env to version control.

# Application Environment (development, test, staging, production)
APP_ENV=development

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Service Configuration Placeholders
PORT=8080
HOST=0.0.0.0

# Database Connection URL (required, valid PostgreSQL URL)
# Placeholder only - put real local credentials in your own .env (gitignored), never commit them.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/rene_wrld
