{
  "name": "rene-wrld",
  "version": "0.1.0",
  "description": "Re:NeWrld Modular Monolith Backend & Core Engine",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node -e \"const fs = require('fs'); if (fs.existsSync('.env')) process.loadEnvFile('.env'); require('./dist/server.js');\"",
    "dev": "tsx --env-file .env watch src/server.ts",
    "test": "APP_ENV=test vitest run",
    "test:watch": "APP_ENV=test DATABASE_URL=postgresql://postgres:postgres@localhost:5432/renewrld_test vitest",
    "test:unit": "APP_ENV=test DATABASE_URL=postgresql://dummy/dummy vitest run tests/unit",
    "test:integration": "APP_ENV=test vitest run tests/integration",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "fastify": "^4.28.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
